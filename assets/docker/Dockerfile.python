# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Python web service / worker (FastAPI, Django, Flask, Celery) for ECS Fargate.
# Uses uv when uv.lock exists, otherwise pip + requirements.txt. Edit the CMD to match Railway's start command.
#
# Build: docker buildx build --platform linux/arm64 -t <ecr>/<repo>:<sha> .
#
# Migrations: there is NO separate tools image for Python. The runtime image already contains the full
# virtualenv and the source tree, so Alembic / Django migrations run with the SAME image and a different
# command. In the deploy workflow set BUILD_TOOLS_IMAGE=false and point the migration task at
# <repo>:<sha> with MIGRATION_COMMAND="alembic upgrade head" (Django: "python manage.py migrate --noinput").
# That one-off task runs BEFORE `terraform apply` rolls the service, mirroring Railway's preDeployCommand.
#
# The RDS CA bundle is baked in so DATABASE_URL can use sslmode=verify-full&sslrootcert=$RDS_CA_BUNDLE_PATH
# (psycopg/asyncpg honour sslrootcert; SQLAlchemy passes it through connect_args). Never ship sslmode=disable
# or sslmode=no-verify to RDS.

ARG RDS_CA_BUNDLE_URL=https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# Base images are pinned by digest (tag kept for readability), so a rebuild never silently picks up a
# different image. Refresh: `docker buildx imagetools inspect <image:tag>` and copy the top-level
# "Digest:" (the multi-arch index, which includes linux/arm64). To change the Python version, change the
# tag AND the digest. Renovate and Dependabot (package-ecosystem: docker) both bump `FROM image:tag@sha256:...`
# lines; Dependabot ignores ARG and COPY --from, hence one literal FROM per image. Renovate also bumps `# syntax=`.
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS base
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM base AS builder
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 UV_PROJECT_ENVIRONMENT=/opt/venv
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml* uv.lock* requirements*.txt ./
RUN --mount=type=cache,target=/root/.cache \
    if [ -f uv.lock ]; then uv sync --frozen --no-dev; \
    else python -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt; fi
COPY . .

FROM base AS runner
ARG RDS_CA_BUNDLE_URL
WORKDIR /app
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8000 \
    RDS_CA_BUNDLE_PATH=/app/global-bundle.pem
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates wget \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 app
COPY --from=builder --chown=app:app /opt/venv /opt/venv
COPY --from=builder --chown=app:app /app /app
ADD --chown=app:app ${RDS_CA_BUNDLE_URL} /app/global-bundle.pem
USER app
EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--"]
# Web:    uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
# Django: gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 2
# Worker: celery -A app.celery worker --loglevel=info   (set container_command / worker_command in Terraform instead of editing this)
# Migrate: alembic upgrade head                          (MIGRATION_COMMAND in the deploy workflow / migration task definition)
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT}"]
