# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generic Node.js service (Express, Fastify, Hono, NestJS, workers) for ECS Fargate.
# Replaces Railway's Railpack/Nixpacks auto-build. Edit the three marked lines to match package.json scripts.
#
# Two images from one file:
#   runner (default, final stage) - built app + production deps only
#   tools                          - built app + ALL deps (dev included), for migrations / one-off scripts
#
# Build:
#   docker buildx build --platform linux/arm64 --target runner -t <ecr>/<repo>:<sha> .
#   docker buildx build --platform linux/arm64 --target tools  -t <ecr>/<repo>:<sha>-tools .
#   Private npm registry: add `--secret id=NPM_TOKEN,env=NPM_TOKEN` to both (see the deps stage).
#
# Why a tools image: `prisma migrate deploy`, `drizzle-kit migrate`, `knex migrate:latest`, `typeorm
# migration:run` and most seed scripts need dev dependencies and the un-bundled source, which the pruned
# runner does not carry. The deploy workflow runs the tools image as a one-off ECS task BEFORE the
# rollout, mirroring Railway's preDeployCommand.
#
# The RDS CA bundle is baked into both images so DATABASE_URL can use sslmode=verify-full
# (pg: ssl: { ca: fs.readFileSync(process.env.RDS_CA_BUNDLE_PATH) }). Never ship rejectUnauthorized:false to RDS.
#
# Lockfiles: `pnpm install --frozen-lockfile` / `npm ci` fail when the lockfile is stale or a stub. Regenerate
# locally (`pnpm install`, `npm install`) and commit before building.

ARG RDS_CA_BUNDLE_URL=https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

# Base images are pinned by digest (tag kept for readability), so a rebuild never silently picks up a
# different image. Refresh: `docker buildx imagetools inspect <image:tag>` and copy the top-level
# "Digest:" (the multi-arch index, which includes linux/arm64). To change the Node version, change the
# tag AND the digest. Renovate and Dependabot (package-ecosystem: docker) both bump `FROM image:tag@sha256:...`
# lines; Dependabot ignores ARG and COPY --from, hence one literal FROM per image. Renovate also bumps `# syntax=`.
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS base
# Yarn 2+ only (npm, pnpm and Yarn 1 ignore these): install into node_modules, since Plug'n'Play writes none and
# the stages below copy node_modules; and keep Yarn's install state inside node_modules so it travels with it.
# Without that state, `yarn run` in the tools image tries to recreate it and fails (EACCES on /app/.yarn).
ENV YARN_NODE_LINKER=node-modules YARN_INSTALL_STATE_PATH=/app/node_modules/.yarn-install-state.gz

FROM base AS deps
WORKDIR /app
# pnpm-workspace.yaml carries pnpm's allowBuilds (dependency build scripts approved with `pnpm approve-builds`,
# e.g. sharp); without it `pnpm install` stops with ERR_PNPM_IGNORED_BUILDS. Yarn 2+ reads .yarnrc.yml, which can
# point at committed files under .yarn/ (yarnPath -> releases, plugins, patch: dependencies -> patches), so those
# come along; .yarnrc.yml alone breaks a yarnPath setup. mkdir: an app with no dependencies gets no
# node_modules from npm, and the COPY --from=deps below needs one.
# Private registry: pass the token as the NPM_TOKEN build secret (`--secret id=NPM_TOKEN,env=NPM_TOKEN`) and
# reference it as `${NPM_TOKEN}` in .npmrc or `"${NPM_TOKEN:-}"` in .yarnrc.yml. It is only an environment
# variable for the install command, never written to a layer. In .yarnrc.yml use `:-`: plain `${NPM_TOKEN}`
# makes every yarn command in the tools image fail when the variable is unset.
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* package-lock.json* yarn.lock* .npmrc* .yarnrc.yml* ./
COPY --parents .yarn/releases* .yarn/plugins* .yarn/patches* ./
RUN --mount=type=secret,id=NPM_TOKEN,env=NPM_TOKEN \
    --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci --no-audit --no-fund; \
    elif [ -f yarn.lock ]; then corepack enable yarn && yarn install --frozen-lockfile; \
    else echo "No lockfile found" && exit 1; fi \
 && mkdir -p node_modules

# ---------- builder: compile with dev deps present ----------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
# (1) Build step: matches Railway's "build command". Remove if the app has no build.
#     Prisma: run `npx prisma generate` before the build (add it to the build script or uncomment below).
# RUN npx prisma generate
RUN sh -c 'if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; else npm run build; fi'

# ---------- tools: full deps + source + build output (NOT the final stage) ----------
FROM base AS tools
ARG RDS_CA_BUNDLE_URL
WORKDIR /app
ENV NODE_ENV=production RDS_CA_BUNDLE_PATH=/app/global-bundle.pem
# openssl: Prisma's query engine needs it on Debian slim images; harmless for everything else.
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable
COPY --from=builder --chown=node:node /app ./
ADD --chown=node:node ${RDS_CA_BUNDLE_URL} /app/global-bundle.pem
USER node
# Fetch the project's Yarn release now, as the user that runs migrations, so `yarn ...` needs no download at
# migration time. `corepack install` reads package.json#packageManager; without it, `yarn --version` fetches
# Corepack's default Yarn.
RUN if [ -f yarn.lock ]; then corepack install || yarn --version; fi
ENTRYPOINT ["/usr/bin/tini", "--"]
# Override per project (or via the Terraform migration task definition `command`):
# Prisma: ["npx","prisma","migrate","deploy"]  Drizzle: ["npx","drizzle-kit","migrate"]  Knex: ["npx","knex","migrate:latest"]
CMD ["npm", "run", "db:migrate"]

# ---------- prod-deps: prune dev dependencies for the runtime image ----------
FROM builder AS prod-deps
# (2) Prune dev dependencies so the runtime image stays small. Yarn 2+ (its yarn.lock has `__metadata:`) prunes with
#     its own command: `npm prune` rejects Yarn-only specifiers such as `patch:`. That re-fetches packages, hence
#     the NPM_TOKEN secret again.
RUN --mount=type=secret,id=NPM_TOKEN,env=NPM_TOKEN \
    sh -c 'if [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm prune --prod; \
    elif grep "^__metadata:" yarn.lock >/dev/null 2>&1; then corepack enable yarn && yarn workspaces focus --all --production; \
    else npm prune --omit=dev; fi'

# ---------- runner: final/default stage ----------
FROM base AS runner
ARG RDS_CA_BUNDLE_URL
WORKDIR /app
ENV NODE_ENV=production PORT=3000 RDS_CA_BUNDLE_PATH=/app/global-bundle.pem
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates wget openssl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=prod-deps --chown=node:node /app ./
ADD --chown=node:node ${RDS_CA_BUNDLE_URL} /app/global-bundle.pem
USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
# (3) Start command: matches Railway's "start command" / Procfile web process.
CMD ["node", "dist/index.js"]
