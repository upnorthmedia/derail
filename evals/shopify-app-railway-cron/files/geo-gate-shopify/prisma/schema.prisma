generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  @@index([shop])
}

model ShopSettings {
  id            Int      @id @default(autoincrement())
  shop          String   @unique
  plan          String   @default("free")
  rulesJson     Json
  updatedAt     DateTime @updatedAt
}

model RestrictionRule {
  id        Int     @id @default(autoincrement())
  shop      String
  country   String
  region    String?
  zipPrefix String?
  message   String
  @@index([shop])
}
