{
  "name": "geo-gate-shopify", "private": true, "type": "module", "engines": { "node": ">=20" },
  "scripts": {
    "build": "react-router build", "dev": "shopify app dev", "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy", "docker-start": "npm run setup && npm run start",
    "poll:subscriptions": "node --import tsx scripts/poll-subscriptions.ts",
    "config:use": "shopify app config use", "deploy": "shopify app deploy"
  },
  "dependencies": {
    "@react-router/node": "7.9.0", "@react-router/serve": "7.9.0", "react-router": "7.9.0",
    "@shopify/shopify-app-react-router": "1.2.0", "@shopify/shopify-app-session-storage-prisma": "7.0.0",
    "@shopify/polaris": "13.9.5", "@shopify/app-bridge-react": "4.2.0",
    "@prisma/client": "6.16.0", "prisma": "6.16.0", "isbot": "5.1.0", "react": "18.3.1", "react-dom": "18.3.1", "tsx": "4.19.0"
  },
  "devDependencies": { "@shopify/cli": "3.85.0", "typescript": "5.9.0", "vite": "6.3.0" }
}
